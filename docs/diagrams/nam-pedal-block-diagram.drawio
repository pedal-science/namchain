  <diagram id="nampedal" name="NAM pedal">
    <mxGraphModel dx="3930" dy="2570" grid="1" gridSize="30" guides="0" tooltips="1" connect="0" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2336" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tib" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=light-dark(#144219,#144219);strokeColor=light-dark(#423012,#423012);strokeWidth=2;fontSize=18;spacing=12;fontColor=light-dark(#FFFFFF,#FCFCFC);fontFamily=Helvetica;miterlimit=2;arcSize=6;" value="&lt;b&gt;tib — ASUS Tinker Board (RK3288)&lt;/b&gt;&lt;br&gt;NAM A2-full kernel · RT kernel&lt;br&gt;isolcpus · SCHED_FIFO · performance governor&lt;br&gt;&lt;b&gt;I2S slave&lt;/b&gt; · &lt;b&gt;I2C master&lt;/b&gt; (codec 0x1A)&lt;br&gt;JACK/PipeWire + LV2 host&lt;br&gt;&lt;i&gt;simple-audio-card DT node,&lt;br&gt;bitclock-master + frame-master on codec DAI&lt;/i&gt;" vertex="1">
          <mxGeometry height="210" width="600" x="-1320" y="-1200" as="geometry" />
        </mxCell>
        <mxCell id="codec" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=light-dark(#144219,#144219);strokeColor=light-dark(#423012,#423012);strokeWidth=2;fontSize=18;spacing=12;fontFamily=Helvetica;fontColor=light-dark(#FFFFFF,#FCFCFC);miterlimit=2;arcSize=6;" value="&lt;b&gt;SparkFun WM8960 breakout&lt;/b&gt;&lt;br&gt;&lt;br&gt;Y1 24 MHz osc → MCLK (always on) — codec is I2S master&lt;br&gt;&lt;br&gt;IN: 100R + 47nF LPF → 1uF coupling → PGA → ADC&lt;br&gt;&lt;i&gt;swap 47nF to 4.7nF if buffer Zout &amp;gt; ~200R&lt;/i&gt;&lt;br&gt;&lt;br&gt;OUT: DAC → HP_L / HP_R — &lt;b&gt;no coupling caps fitted&lt;/b&gt;&lt;br&gt;&lt;i&gt;OUT3 unused — leave disabled in registers&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Jumpers:&lt;/b&gt; AVDD-ISO CUT · SPKVDD both open · VIN n/c&lt;br&gt;3V3 pin → DCVDD, DBVDD, Y1 · AVDD ← external LDO" vertex="1">
          <mxGeometry height="330" width="600" x="-1320" y="-810" as="geometry" />
        </mxCell>
        <mxCell id="injack" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFE6CC,#784811);strokeColor=#b4531f;strokeWidth=2;fontSize=18;spacing=12;align=left;miterlimit=2;arcSize=6;verticalAlign=top;" value="&lt;b&gt;Guitar / LIne In&lt;/b&gt;&lt;br&gt;6.35 mm TS" vertex="1">
          <mxGeometry height="90" width="210" x="-1950" y="-720" as="geometry" />
        </mxCell>
