        <mxCell id="pico" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=light-dark(#144219,#144219);strokeColor=light-dark(#423012,#423012);strokeWidth=2;fontSize=18;spacing=12;fontColor=light-dark(#FFFFFF,#FCFCFC);miterlimit=2;arcSize=6;" value="&lt;div&gt;&lt;b&gt;Pico 2 &lt;/b&gt;- &lt;i&gt;control surface only&lt;/i&gt;&lt;/div&gt;Footswitches · Rotary Encoder · OLED · Status LEDs&lt;br&gt;Expression pedal ADC · MIDI&lt;br&gt;Talks to tib over UART; tib applies changes via ALSA mixer controls" vertex="1">
